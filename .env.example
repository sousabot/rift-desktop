# Copy this file to .env for local development (npm run dev / npm run server).
# Get a key at https://developer.riotgames.com
RIOT_API_KEY=

# Discord channel webhook for the Report feedback / bugs form.
DISCORD_WEBHOOK_URL=

# Packaged builds use client.env (RIFT_API_URL + RIFT_APP_TOKEN) instead of this file.
RIFT_API_URL=https://gd-desktop.onrender.com
RIFT_APP_TOKEN=

# Stripe Premium checkout (set on the API server / .env used by `npm run server`).
# Prefer Price IDs (price_…). Product IDs (prod_…) also work — we resolve default_price.
#
# Your products:
#   month     → prod_V6pBdbYhdqfonk
#   6 months  → prod_V6psnJf9Lx7mos
#   year      → prod_V6pvF3DJhfyHOg
#
# In Stripe Dashboard → Product → copy either the default Price (price_…) OR the Product id.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTH=prod_V6pBdbYhdqfonk
STRIPE_PRICE_SIX=prod_V6psnJf9Lx7mos
STRIPE_PRICE_YEAR=prod_V6pvF3DJhfyHOg
# Optional aliases (same slots — use if you prefer the PRODUCT_ names):
# STRIPE_PRODUCT_MONTH=prod_V6pBdbYhdqfonk
# STRIPE_PRODUCT_SIX=prod_V6psnJf9Lx7mos
# STRIPE_PRODUCT_YEAR=prod_V6pvF3DJhfyHOg
# Optional — defaults to STRIPE_SECRET_KEY for signing unlock licenses + gift codes
PREMIUM_LICENSE_SECRET=
# Optional simple gift aliases (single-use by default): CODE:plan or CODE:plan:maxUses
# PREMIUM_GIFT_CODES=FRIEND1:year,BETA2026:six:1,LAUNCH:month:25
# Where claimed gifts are stored (shared across users — put this on the API host)
# PREMIUM_GIFT_STORE=/var/data/gift-redemptions.json
# Optional public base used in success/cancel URLs (defaults to RIFT_API_URL / request host)
STRIPE_PUBLIC_URL=
# Optional overrides (use {CHECKOUT_SESSION_ID} in success URL)
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=
